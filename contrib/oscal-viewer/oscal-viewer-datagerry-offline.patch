+/* ═══════════════════════════════════════════════════════════════════════════
+   DATAGERRY Theme — used by the copy of the viewer that ships with DATAGERRY
+   (app/src/assets/oscal/viewer). Values follow DATAGERRY's SCSS:
+     $primary #e94d18, $cmdb-secondary #fbba00, body colour #212529,
+     Bootstrap borders #dee2e6, sidebar/footer greys #f9f9fb / #f2f2f2.
+   DATAGERRY has no dark mode, so only light colours are defined.
+   ═══════════════════════════════════════════════════════════════════════════ */
+
+import type { ThemeDefinition, ThemeColors } from "../themeContract";
+
+const PRIMARY = "#E94D18";        /* $primary / $cmdb-primary */
+const SECONDARY = "#FBBA00";      /* $cmdb-secondary */
+const BODY = "#212529";           /* Bootstrap $body-color */
+const MUTED = "#6C757D";          /* Bootstrap $secondary-color text */
+const BORDER = "#DEE2E6";         /* Bootstrap $border-color */
+
+const lightColors: ThemeColors = {
+  /* ── Tier 1 ── */
+  navy: BODY,                 /* headings, primary icons */
+  orange: PRIMARY,            /* accent: active nav item, buttons, params */
+  yellow: SECONDARY,
+  gray: MUTED,
+
+  /* ── Tier 2 ── */
+  darkNavy: "#2C3E50",        /* rare dark surfaces (DATAGERRY input/ink colour) */
+  brightBlue: PRIMARY,        /* links (Bootstrap $link-color = $primary) */
+  paleGray: BORDER,
+  black: BODY,
+
+  /* ── Tier 3 ── */
+  cobalt: "#2C3E50",
+  mint: "#198754",
+  darkGreen: "#198754",
+  brightCyan: PRIMARY,
+  purple: "#6F42C1",
+  blueGray: "#495057",
+  paleOrange: "#F28B66",
+  neonYellow: SECONDARY,
+
+  /* ── Semantic / UI ── */
+  white: "#FFFFFF",
+  bg: "#F9F9FB",              /* DATAGERRY sidebar surface */
+  card: "#FFFFFF",
+  red: "#DC3545",
+
+  /* ── Status ── */
+  statusPassBg: "#D1E7DD",
+  statusPassFg: "#0F5132",
+  statusPassBorder: "#198754",
+  statusFailBg: "#F8D7DA",
+  statusFailFg: "#842029",
+  statusFailBorder: "#DC3545",
+  statusErrorBg: "#FFF3CD",
+  statusErrorFg: "#664D03",
+  statusErrorBorder: SECONDARY,
+  statusNaBg: "#E9ECEF",
+  statusNaFg: "#495057",
+  statusNaBorder: "#ADB5BD",
+
+  /* ── Surface variants ── */
+  surfaceSubtle: "#F2F2F2",   /* DATAGERRY breadcrumb / footer grey */
+  surfaceMuted: "#F8F9FA",
