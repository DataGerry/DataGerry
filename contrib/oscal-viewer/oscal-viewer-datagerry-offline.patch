+++ build/oscal-viewer-main/src/utils/embedded.ts	2026-10-13 11:24:42.782476305 +0000
@@ -0,0 +1,21 @@
+/* ═══════════════════════════════════════════════════════════════════════════
+   DATAGERRY embedding — the viewer is opened by DATAGERRY either inside an
+   iframe on the ISMS catalog page (`#/catalog?url=…&embedded=1`) or as a
+   standalone page in a new tab. Embedded mode hides the viewer's own header
+   so the page blends into DATAGERRY.
+   ═══════════════════════════════════════════════════════════════════════════ */
+
+function readParam(name: string): string | null {
+  if (typeof window === "undefined") return null;
+  const { search, hash } = window.location;
+  const fromSearch = new URLSearchParams(search).get(name);
+  if (fromSearch != null) return fromSearch;
+  const q = hash.indexOf("?");
+  return q >= 0 ? new URLSearchParams(hash.slice(q + 1)).get(name) : null;
+}
+
+/** Read once at start-up; in-viewer navigation does not change the URL. */
+export const isEmbedded: boolean = (() => {
+  const v = readParam("embedded");
+  return v === "1" || v === "true";
+})();
